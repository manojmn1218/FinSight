# ═══════════════════════════════════════════════
# FinSight Backend & Database Configuration
# ═══════════════════════════════════════════════

# Port for the Node.js / Express backend server
PORT=5000
NODE_ENV=development

# JWT Secret for signing session tokens
JWT_SECRET=your_super_secret_jwt_key_finsight_2026_secured!

# ═══════════════════════════════════════════════
# MongoDB Atlas Database Connection String
# ═══════════════════════════════════════════════
# FinSight automatically uses local persistent storage (server/data/finsight_db.json)
# if MONGODB_URI is left blank.
#
# To connect your MongoDB Atlas cloud database:
# 1. Create a free cluster at https://www.mongodb.com/atlas
# 2. Click "Connect" → "Drivers" (Node.js)
# 3. Paste your connection URI below:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/finsight?retryWrites=true&w=majority

# ═══════════════════════════════════════════════
# Setu Account Aggregator Configuration
# ═══════════════════════════════════════════════
# Get these from https://bridge.setu.co after creating an AA Data product.

# Setu API credentials (from Bridge → API Credentials)
SETU_CLIENT_ID=your_client_id_here
SETU_CLIENT_SECRET=your_client_secret_here

# Product instance ID (from Bridge → Product Settings)
SETU_PRODUCT_INSTANCE_ID=your_product_instance_id_here

# Setu API base URL
# Sandbox: https://aa-sandbox.setu.co
# Production: https://aa.setu.co
SETU_BASE_URL=https://aa-sandbox.setu.co

# Where Setu redirects users after consent approval/rejection
SETU_REDIRECT_URL=http://localhost:5173/transactions?setu_consent=callback

# Set to 'true' to use mock data instead of real Setu API
VITE_SETU_MOCK=true

# ═══════════════════════════════════════════════
# Google OAuth 2.0 Configuration
# ═══════════════════════════════════════════════
# Get from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ═══════════════════════════════════════════════
# Twilio API Configuration (Email OTP)
# ═══════════════════════════════════════════════
# Method 1: Twilio SendGrid Email API (Recommended)
TWILIO_SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
TWILIO_EMAIL_FROM=security@finsight.com

# Method 2: Twilio Verify API
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
